# RV Community Ops — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# OpenAI API key — used for call extraction (required)
OPENAI_API_KEY=your_openai_api_key_here

# CoinMarketCap API key — crypto price lookups
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Polygon.io API key — stock/ETF price lookups and sentiment chart
POLYGON_API_KEY=your_polygon_api_key_here

# Finnhub API key — fallback for sentiment chart
FINNHUB_API_KEY=your_finnhub_api_key_here
